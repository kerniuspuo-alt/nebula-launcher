# Azure AD public client with Xbox Live + Minecraft API permissions
NEBULA_MS_CLIENT_ID=

# Spotify Developer app public Client ID, embedded into the app at build time.
# Register http://127.0.0.1:17385/callback as its Redirect URI.
# Users can connect with one click once this is configured by the app publisher.
VITE_SPOTIFY_CLIENT_ID=

# Configure a real HTTPS manifest URL before building a release with app:build:updater.
# TAURI_SIGNING_PRIVATE_KEY should point to your local Tauri key (never commit the key itself).
NEBULA_UPDATER_ENDPOINT=https://updates.example.com/nebula/latest.json
TAURI_SIGNING_PRIVATE_KEY=
